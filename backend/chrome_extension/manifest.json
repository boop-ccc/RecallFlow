{
  "manifest_version": 3,
  "name": "RecallFlow",
  "version": "0.1.0",
  "description": "Capture the current page and resume work with RecallFlow.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "RecallFlow"
  }
}
